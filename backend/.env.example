# Database — defaults to local SQLite; point at Postgres in production
DATABASE_URL=sqlite:///./explore.db

# Which provider backs AI charter/risk suggestions and debrief drafting by default.
# One of: mock, claude, openai, local
# "mock" needs no API key or billing — good for building/testing the app itself.
# Switch to "claude" once billing is set up on your Anthropic account; nothing
# else in the app needs to change.
DEFAULT_AI_PROVIDER=local

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LOCAL_MODEL_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen3:8b
