# Database — defaults to local SQLite; point at Postgres in production
DATABASE_URL=sqlite:///./mirmera.db

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Which provider backs AI features by default: mock, claude, openai or local.
# "mock" needs no API key or billing — good for building/testing the app itself.
# Switch whenever you're ready; nothing else in the app needs to change.
DEFAULT_AI_PROVIDER=mock

# claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# openai (also any OpenAI-compatible server, e.g. LM Studio: http://localhost:1234/v1)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# local (Ollama)
LOCAL_MODEL_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen3:8b
# Thinking models (qwen3...) reason before answering; off by default: faster, and no empty replies
LOCAL_MODEL_THINK=false
# ---- Issue trackers ----
# Which repo / Jira project each product files to is set in the app (Bugs page).
# Only the credentials go here; they never reach the browser.

# GitHub: a fine-grained personal access token with "Issues: Read and write"
# on the repos you file to (github.com/settings/personal-access-tokens).
GITHUB_TOKEN=
# Optional labels added to new issues; they must already exist in the repo.
GITHUB_LABELS=

# Jira Cloud: your site, your Atlassian account email, and an API token
# (id.atlassian.com/manage-profile/security/api-tokens).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_ISSUE_TYPE=Bug

# true = in-memory GitHub and Jira, to try the flow without accounts.
MOCK_TRACKERS=false

# Check filed issues every N minutes and retest the newly closed ones (0 = only the button).
RETEST_POLL_MINUTES=0

# Optional: where testers open Mirmera, so filed issues can link back.
PUBLIC_APP_URL=

# Recorded browser: extra signals (evidence, not verdicts).
RUNNER_ACCESSIBILITY_CHECKS=true   # check each page when it loads: labels, alt text, contrast, names, lang
SLOW_REQUEST_MS=2000               # record API calls (fetch/XHR) slower than this
SLOW_PAGE_MS=3000                  # record pages that take longer than this to load

# ---- Notifications (Settings -> Notifications picks the chat and events per project) ----
# Telegram: a bot token from @BotFather. Message the bot first; bots can't start a chat.
TELEGRAM_BOT_TOKEN=
# Slack: an incoming webhook for the channel (api.slack.com/messaging/webhooks).
SLACK_WEBHOOK_URL=
# true = keep messages in the app (Recent) instead of sending them.
MOCK_NOTIFICATIONS=false
