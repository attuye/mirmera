# Mirmera on a server: copy to deploy/.env (never commit it) and fill in.
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# Database, evidence and secret.key paths are set in docker-compose.yml (/data).

# ---- the address ----
# The domain whose A record points at this server. Caddy gets its HTTPS certificate.
DOMAIN=mirmera.example.com
PUBLIC_APP_URL=https://mirmera.example.com
CORS_ORIGINS=https://mirmera.example.com
COOKIE_SECURE=true
API_DOCS=false

# ---- accounts ----
# true until you have created your account (and your team's, or invite them); then false
ALLOW_SIGNUPS=true

# ---- secrets ----
# Workspace keys are encrypted with this. Moving from your laptop: copy the same value
# from backend/.env there, or saved keys (Jira, GitHub, Telegram...) can't be read here.
# New install: any long random phrase (python -c "import secrets; print(secrets.token_urlsafe(48))").
# Keep a copy somewhere safe, apart from the backups.
MIRMERA_SECRET_KEY=

# ---- AI ----
# Qwen on your laptop, reached through the tunnel (scripts/qwen-tunnel on the laptop)
DEFAULT_AI_PROVIDER=local
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=qwen3:8b

# ---- testing from a server ----
# true refuses API exploration of private and cloud-metadata addresses. Set it when people
# outside your team use this Mirmera.
API_BLOCK_PRIVATE=false
# Workspaces without their own keys use the server's keys below. false once other companies use it.
SERVER_KEYS_FOR_ALL=true

# ---- email (invitations, password resets) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mirmera <no-reply@example.com>

# ---- never on a server ----
MOCK_TRACKERS=false
MOCK_EMAIL=false
MOCK_NOTIFICATIONS=false

# ---- backups (deploy/backup.sh) to S3-compatible storage, e.g. AletCloud object storage ----
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_KEEP_DAYS=14
