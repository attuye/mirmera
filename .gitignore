e2e/test-results/
e2e/playwright-report/
e2e/.e2e-data/
e2e/.generated/

# Build output
dist/
*.tsbuildinfo
# backend/latest_run.py writes this: a run's dump, to read or share, not to commit
backend/latest_run.txt
